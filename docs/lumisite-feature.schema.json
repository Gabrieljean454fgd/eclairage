{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Gabrieljean454fgd/eclairage/docs/lumisite-feature.schema.json",
  "title": "LumiSite GeoJSONSeq Feature (equipment), schema_version 1.0.0",
  "type": "object",
  "required": ["type", "id", "geometry", "properties"],
  "not": { "required": ["crs"] },
  "properties": {
    "type": { "const": "Feature" },
    "id": { "type": "string", "minLength": 1 },
    "geometry": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object", "required": ["type", "coordinates"],
          "properties": {
            "type": { "const": "Point" },
            "coordinates": { "type": "array", "minItems": 2, "maxItems": 3,
              "items": [ { "type": "number", "minimum": -180, "maximum": 180 }, { "type": "number", "minimum": -90, "maximum": 90 }, { "type": "number" } ] }
          }
        }
      ]
    },
    "properties": {
      "type": "object",
      "required": ["rev", "op", "kind", "block_name", "catalog_version", "layer", "status", "local", "accuracy", "time", "device_id", "session_id", "operator"],
      "properties": {
        "rev": { "type": "integer", "minimum": 1 },
        "op": { "enum": ["create", "update", "delete"] },
        "kind": { "enum": ["equipment", "annotation", "height", "shape", "zone", "control_point", "route", "track"] },
        "block_name": { "type": "string", "minLength": 1 },
        "catalog_version": { "type": ["string", "null"] },
        "layer": { "type": "string" },
        "status": { "enum": ["existant", "projeté", "à déposer", "en défaut"] },
        "local": {
          "oneOf": [
            { "type": "null" },
            { "type": "object", "required": ["frame_id", "x", "y", "z"],
              "properties": { "frame_id": { "type": "string" }, "x": { "type": "number" }, "y": { "type": "number" }, "z": { "type": "number" } } }
          ]
        },
        "accuracy": { "type": "object", "required": ["sigma_xy_m", "sigma_z_m", "method"],
          "properties": { "sigma_xy_m": { "type": ["number", "null"] }, "sigma_z_m": { "type": ["number", "null"] }, "method": { "type": "string" } } },
        "time": { "type": "object", "required": ["captured_utc", "device_monotonic_ns", "clock_offset_ms", "clock_sigma_ms", "sync_ref"],
          "properties": {
            "captured_utc": { "type": "string" }, "device_monotonic_ns": { "type": "integer" },
            "clock_offset_ms": { "type": ["number", "null"] }, "clock_sigma_ms": { "type": ["number", "null"] }, "sync_ref": { "type": ["string", "null"] } } },
        "device_id": { "type": "string" },
        "session_id": { "type": "string" },
        "operator": { "type": ["string", "null"] },
        "aim": { "type": "object", "properties": { "azimuth_deg": { "type": "number" }, "ref": { "const": "site_north" }, "tilt_deg": { "type": "number" }, "sigma_deg": { "type": ["number", "null"] } } },
        "height_m": { "type": "number" },
        "height_ref": { "type": "string" },
        "details": { "type": "object" },
        "label": { "type": "string" },
        "note": { "type": "string" },
        "voice_notes": { "type": "array" },
        "photos": { "type": "array", "items": { "type": "object", "required": ["photo_id", "path"],
          "properties": { "photo_id": { "type": "string" }, "path": { "type": "string" }, "sha256": { "type": ["string", "null"] } } } },
        "registration": {},
        "duplicate_of": { "type": "string" },
        "supersedes": { "type": "string" },
        "event_id": { "type": "string" }
      }
    }
  }
}
